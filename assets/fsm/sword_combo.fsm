{
    "version": 2,
    "name": "SwordCombo",

    "parameters": [
        { "name": "attackPressed", "type": "trigger" },
        { "name": "hit",           "type": "trigger" },
        { "name": "canMove",       "type": "bool", "default": true }
    ],

    "states": [
        {
            "name": "Idle",
            "actions": [
                { "type": "SetParam", "param": "canMove", "value": { "type": "bool", "value": true } },
                { "type": "PlayPose", "pose": "guard", "duration": 0.0 }
            ],
            "editor": { "x": 0, "y": 0 }
        },
        {
            "name": "Attack1",
            "actions": [
                { "type": "SetParam", "param": "canMove", "value": { "type": "bool", "value": false } },
                { "type": "PlayPose", "pose": "slash_right", "duration": 0.5 },
                { "type": "SpawnHitbox", "start": 0.1, "end": 0.25, "damage": 10, "range": 1.5 },
                { "type": "PlaySound", "sound": "assets/sounds/swing_1.wav" }
            ],
            "editor": { "x": 250, "y": 0 }
        },
        {
            "name": "Attack2",
            "actions": [
                { "type": "SetParam", "param": "canMove", "value": { "type": "bool", "value": false } },
                { "type": "PlayPose", "pose": "slash_left", "duration": 0.5 },
                { "type": "SpawnHitbox", "start": 0.1, "end": 0.25, "damage": 12, "range": 1.5 },
                { "type": "PlaySound", "sound": "assets/sounds/swing_2.wav" }
            ],
            "editor": { "x": 500, "y": 0 }
        },
        {
            "name": "Attack3",
            "actions": [
                { "type": "SetParam", "param": "canMove", "value": { "type": "bool", "value": false } },
                { "type": "PlayPose", "pose": "thrust", "duration": 0.7 },
                { "type": "SpawnHitbox", "start": 0.25, "end": 0.4, "damage": 25, "range": 2.0 },
                { "type": "PlaySound", "sound": "assets/sounds/thrust.wav" }
            ],
            "editor": { "x": 750, "y": 0 }
        },
        {
            "name": "Hit",
            "actions": [
                { "type": "SetParam", "param": "canMove", "value": { "type": "bool", "value": false } },
                { "type": "PlayPose", "pose": "stagger", "duration": 0.4 },
                { "type": "PlaySound", "sound": "assets/sounds/hurt.wav" }
            ],
            "editor": { "x": 375, "y": 200 }
        }
    ],

    "entryState": "Idle",

    "transitions": [
        { "from": "Any", "to": "Hit",
          "conditions": [ { "param": "hit" } ] },

        { "from": "Hit", "to": "Idle",
          "conditions": [ { "param": "$stateTime", "op": ">=", "value": 0.4 } ] },

        { "from": "Idle", "to": "Attack1",
          "conditions": [ { "param": "attackPressed" } ] },

        { "from": "Attack1", "to": "Attack2",
          "conditions": [
              { "param": "attackPressed" },
              { "param": "$stateTime", "op": ">=", "value": 0.2 },
              { "param": "$stateTime", "op": "<=", "value": 0.5 }
          ] },
        { "from": "Attack1", "to": "Idle",
          "conditions": [ { "param": "$stateTime", "op": ">", "value": 0.5 } ] },

        { "from": "Attack2", "to": "Attack3",
          "conditions": [
              { "param": "attackPressed" },
              { "param": "$stateTime", "op": ">=", "value": 0.2 },
              { "param": "$stateTime", "op": "<=", "value": 0.5 }
          ] },
        { "from": "Attack2", "to": "Idle",
          "conditions": [ { "param": "$stateTime", "op": ">", "value": 0.5 } ] },

        { "from": "Attack3", "to": "Idle",
          "conditions": [ { "param": "$stateTime", "op": ">=", "value": 0.7 } ] }
    ]
}
